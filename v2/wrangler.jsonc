{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gdtxdinhquan-v2",
  // Ghim tài khoản giống deploy.js của bản cũ (ledinhphat1994) để không deploy nhầm tài khoản.
  "account_id": "bfc647e65d847f61ca386b7f11c27173",
  "main": "./worker/index.ts",
  // Khớp bản workerd đi kèm wrangler đang dùng (1.20260911.x); nâng wrangler thì nâng ngày này theo.
  "compatibility_date": "2026-09-11",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lop-10a7-db-staging",
      // D1 staging riêng của v2. TUYỆT ĐỐI không đặt id D1 production (lop-10a7-db) vào đây.
      "database_id": "46ed8936-b447-4f10-8983-8f3c3d310e9f",
      // Dev local tiếp tục dùng bản sao local đã nạp sẵn.
      "preview_database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      // KV riêng của v2 (gdtxdinhquan-v2-rate-limit), không dùng chung KV của web thật.
      "id": "d8cd90e018eb4da3ba697aaba555115c",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      // Một object duy nhất cho toàn trường: người online, chat toàn trường, danh bạ phòng của sảnh.
      { "name": "CAMPUS", "class_name": "CampusDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["CampusDO"] }
  ],
  "observability": { "enabled": true }
}
