{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gdtxdinhquan-v2",
  "main": "./worker/index.ts",
  // Ngày tối đa mà workerd đi kèm wrangler 4.86.0 (bản cuối chạy được trên Node 20) hỗ trợ.
  "compatibility_date": "2026-04-26",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lop-10a7-db-staging",
      // Id giả chỉ dùng cho D1 local. Thay bằng id D1 staging trước khi deploy preview —
      // TUYỆT ĐỐI không đặt id D1 production (lop-10a7-db) vào đây.
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      // Id giả chỉ dùng local. Thay bằng KV riêng của v2 trước khi deploy preview.
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
