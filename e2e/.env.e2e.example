# Template biến môi trường cho Playwright E2E Suite (Chỉ chứa tên biến)
# Sao chép file này sang .env.e2e (file không được commit vào Git) và điền thông tin thực tế khi chạy cục bộ.
# Chú ý: Nếu mật khẩu có ký tự '#' hoặc ký tự đặc biệt, BẮT BUỘC đặt trong dấu ngoặc kép "" (ví dụ: E2E_HOST_PASSWORD="...").
# Trên CI (GitHub Actions), các biến này được nạp từ GitHub Secrets.

PLAYWRIGHT_BASE_URL=
E2E_HOST_USERNAME=
E2E_HOST_PASSWORD=
E2E_MEMBER_B_USERNAME=
E2E_MEMBER_B_PASSWORD=
E2E_MEMBER_C_USERNAME=
E2E_MEMBER_C_PASSWORD=
E2E_PASSWORD_ROOM_PASSWORD=
E2E_PUBLIC_ROOM_ID=
E2E_PASSWORD_ROOM_ID=
