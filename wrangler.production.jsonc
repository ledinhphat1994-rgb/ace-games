{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production config — explicitly uses production D1 (a12de014 = lop-10a7-db)
  "name": "gdtxdinhquan",
  "account_id": "bfc647e65d847f61ca386b7f11c27173",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    // Client ID OAuth của Google (công khai). Client secret là secret GOOGLE_CLIENT_SECRET, không nằm ở đây.
    "GOOGLE_CLIENT_ID": "577501894374-kcagug39fsl0sja2btigm5vabc3qfp84.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lop-10a7-db",
      "database_id": "a12de014-e9d2-4d6d-994f-dcb36c481432",
      "migrations_dir": "migrations"
    },
    {
      "binding": "ANALYTICS_DB",
      "database_name": "lop-10a7-analytics",
      "database_id": "96f70f96-e129-4e28-be53-45b672883053",
      "migrations_dir": "analytics-migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "e2529ac570cb4d77a246f38953dcbc9f"
    }
  ],
  "ratelimits": [
    {
      "name": "MODERATION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ADMIT_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "GAME_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANH",
      "bucket_name": "lop-10a7-anh"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "CAMPUS", "class_name": "CampusDO" },
      { "name": "GAME_LOBBY", "class_name": "GameLobbyDO" },
      { "name": "GAME_SESSIONS", "class_name": "GameSessionDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["CampusDO"] },
    { "tag": "v3", "new_sqlite_classes": ["GameLobbyDO"] },
    { "tag": "v4", "new_sqlite_classes": ["GameSessionDO"] }
  ],
  // Cloudflare Email Service: gửi mã khôi phục mật khẩu tới Gmail đã liên kết (from phải thuộc tên miền đã onboard).
  "send_email": [{ "name": "EMAIL" }],
  "observability": { "enabled": true }
}
