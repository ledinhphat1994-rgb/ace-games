# Buộc trình duyệt LUÔN hỏi lại máy chủ trước khi dùng bản đã lưu (no-cache = vẫn được lưu,
# nhưng phải xác nhận "còn mới" với máy chủ mỗi lần — dùng ETag nên vẫn nhanh, không tải lại
# toàn bộ nếu không đổi gì). Tránh lặp lại nhiều lần lỗi "sửa code xong nhưng người dùng vẫn
# thấy bản cũ" — nhất là học sinh/cán sự, vì chỉ có trang /giao-vien/ mới có service worker
# (sw.js) tự ép lấy bản mới; trang chủ và trang cá nhân không có lớp bảo vệ đó.
# Lớp phòng thủ ở tầng CDN cho mọi phản hồi — CSP đầy đủ nằm trong functions/_middleware.js
# (middleware chạy trước mọi request, kể cả tệp tĩnh) để giữ chính sách một nguồn duy nhất.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# Ảnh nền và biểu tượng tĩnh: cho trình duyệt lưu lại 1 ngày, tiết kiệm 3G/4G của học sinh.
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  Cache-Control: no-cache

/giao-vien/*
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
