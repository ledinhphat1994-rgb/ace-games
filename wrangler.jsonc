{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ace-games",
  "compatibility_date": "2026-09-11",
  "routes": [
    { "pattern": "gdtxdinhquan.com", "custom_domain": true },
    { "pattern": "www.gdtxdinhquan.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
