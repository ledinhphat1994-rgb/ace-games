{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "context7": {
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp"]
    },
    "cloudflare": {
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@cloudflare/mcp-server-cloudflare", "run"]
    },
    "github": {
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "github-mcp-server"]
    }
  }
}
