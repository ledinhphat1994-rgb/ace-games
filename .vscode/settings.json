{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "*.webmanifest": "json",
    ".dev.vars": "properties",
    ".dev.vars.example": "properties"
  },
  "search.exclude": {
    "**/node_modules": true,
    "dist": true,
    ".wrangler": true,
    "package-lock.json": true,
    "**/.git": true,
    "**/.system_generated": true,
    "**/.tempmediaStorage": true,
    "**/.vite": true,
    "**/coverage": true,
    "unrealworld/**": true
  },
  "files.exclude": {
    "unrealworld/**": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.wrangler/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.system_generated/**": true,
    "**/.tempmediaStorage/**": true,
    "**/.vite/**": true,
    "**/coverage/**": true
  },
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript"],
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, wrangler.toml, eslint.config.mjs, .editorconfig, .gitignore, .dev.vars*"
  },
  "godotTools.editorPath.godot4": "D:\\Godot_v4.7.2-stable_win64.exe\\Godot_v4.7.2-stable_win64.exe",
  "godot_tools.editor_path": "D:\\Godot_v4.7.2-stable_win64.exe\\Godot_v4.7.2-stable_win64.exe",
  "godotTools.lsp.serverHost": "127.0.0.1",
  "godotTools.lsp.serverPort": 6005,
  "godot_tools.lsp.server_port": 6005,
  "godotTools.lsp.headless": false,
  "godotTools.lsp.autoReconnect.enabled": true,
  "css.lint.unknownAtRules": "ignore",
  "geminicodeassist.enable": true,
  "geminicodeassist.inlineSuggestions.enableAuto": true,
  "geminicodeassist.localCodebaseAwareness": true,
  "geminicodeassist.languages": ["*"]
}
