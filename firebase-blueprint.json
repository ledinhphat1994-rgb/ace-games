{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile metadata synchronized across devices",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "maxLength": 64,
          "description": "User display name"
        },
        "avatar": {
          "type": "string",
          "maxLength": 256,
          "description": "Avatar resource path or URL"
        },
        "role": {
          "type": "string",
          "enum": ["student", "teacher", "admin"],
          "description": "Role of the user in the digital campus"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["displayName", "updatedAt"]
    },
    "gameScore": {
      "title": "GameScore",
      "description": "Leaderboard game score record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the player"
        },
        "playerName": {
          "type": "string",
          "maxLength": 64,
          "description": "Display name of the player"
        },
        "gameType": {
          "type": "string",
          "maxLength": 32,
          "description": "Identifier of the game played"
        },
        "score": {
          "type": "number",
          "description": "Score achieved in the game"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the score was recorded"
        }
      },
      "required": ["userId", "playerName", "gameType", "score", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "User profile documents keyed by user ID"
    },
    "/gameScores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/gameScore"
      },
      "description": "Global game score and achievement entries"
    }
  }
}
