{
  "name": "digital-campus-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -b",
    "build": "wrangler types && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test e2e/watch-together.spec.ts e2e/watch-autoplay.spec.ts",
    "test:e2e:watch:ui": "playwright test e2e/watch-together.spec.ts e2e/watch-autoplay.spec.ts --ui",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium-watch",
    "preview": "vite preview",
    "preview:worker": "wrangler dev --config wrangler.jsonc --assets ./dist/client --persist-to .wrangler/state --port 8787",
    "deploy": "npm run build && npx wrangler deploy --config wrangler.production.jsonc",
    "deploy:staging": "npm run build && npx wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "npm run build && npx wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "hono": "4.13.7",
    "lucide-react": "^1.46.0",
    "partysocket": "1.3.0",
    "perfect-freehand": "1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/vitest-plugin": "1.1.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/youtube": "0.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "node": "24.21.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
