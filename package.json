{
  "name": "ace-games",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc -b",
    "build": "wrangler types && tsc -b && vite build",
    "build:bundle": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:perf": "tsx scripts/benchmark.ts",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test e2e/watch-together.spec.ts e2e/watch-autoplay.spec.ts",
    "test:e2e:watch:ui": "playwright test e2e/watch-together.spec.ts e2e/watch-autoplay.spec.ts --ui",
    "test:e2e:collab": "playwright test e2e/study-collaboration.spec.ts --project=chromium-watch",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium-watch",
    "test:e2e:voice": "playwright test e2e/voice-webrtc.spec.ts --project=chromium-voice",
    "test:e2e:voice:autoplay": "playwright test e2e/voice-webrtc.spec.ts --project=chromium-voice-autoplay-restricted",
    "preview": "vite preview",
    "preview:worker": "wrangler dev --config wrangler.jsonc --assets ./dist/client --persist-to .wrangler/state --port 8787",
    "deploy": "node -e \"console.error('ERROR: Use npm run deploy:staging or npm run deploy:production explicitly.'); process.exit(1)\"",
    "deploy:staging": "npm run build && npx wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "node scripts/deploy-production.mjs",
    "clean:cpu": "node scripts/clean-cpu.mjs",
    "cap:sync": "cap sync android",
    "cap:copy": "cap copy android",
    "cap:open": "cap open android",
    "mobile:start": "npm --prefix mobile start",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "game:godot": "godot -e --path games-dev/godot-project",
    "game:dev": "node games-dev/dev.mjs",
    "game:watch": "node games-dev/watch-and-sync.mjs",
    "game:export": "node games-dev/export-to-app.mjs",
    "game:preview": "node games-dev/web-preview/serve.mjs",
    "game:test": "godot --headless --path games-dev/godot-project -s addons/gut/gut_cmdln.gd -gdir=res://test/unit -gexit",
    "sync:gemini": "repomix"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "docx-preview": "^0.4.1",
    "firebase": "^13.0.0",
    "hono": "4.13.7",
    "lucide-react": "^1.46.0",
    "partysocket": "1.3.0",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "1.2.3",
    "phaser": "4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/vitest-plugin": "1.1.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/youtube": "0.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "node": "24.21.0",
    "oxlint": "^1.81.0",
    "qrcode": "^1.5.4",
    "repomix": "^1.18.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "@aiden0z/pptx-renderer": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  }
}
