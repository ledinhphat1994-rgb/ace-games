{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Config riêng cho staging env — deploy đến gdtxdinhquan-v2 với staging D1/KV
  "name": "gdtxdinhquan-v2",
  "account_id": "bfc647e65d847f61ca386b7f11c27173",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lop-10a7-db-staging",
      "database_id": "46ed8936-b447-4f10-8983-8f3c3d310e9f",
      "migrations_dir": "migrations"
    },
    {
      "binding": "ANALYTICS_DB",
      "database_name": "lop-10a7-analytics-staging",
      "database_id": "c5c3eaec-c6b2-4b09-9d1b-bc18a2288a54",
      "migrations_dir": "analytics-migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "d8cd90e018eb4da3ba697aaba555115c"
    }
  ],
  "ratelimits": [
    {
      "name": "MODERATION_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ADMIT_LIMITER",
      "namespace_id": "2004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANH",
      "bucket_name": "lop-10a7-anh-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "CAMPUS", "class_name": "CampusDO" },
      { "name": "GAME_LOBBY", "class_name": "GameLobbyDO" },
      { "name": "GAME_SESSIONS", "class_name": "GameSessionDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["CampusDO"] },
    { "tag": "v3", "new_sqlite_classes": ["GameLobbyDO"] },
    { "tag": "v4", "new_sqlite_classes": ["GameSessionDO"] }
  ],
  "observability": { "enabled": true }
}
