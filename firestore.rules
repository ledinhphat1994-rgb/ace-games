rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'updatedAt']) &&
             data.keys().hasOnly(['displayName', 'avatar', 'role', 'updatedAt']) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 256)) &&
             (!('role' in data) || (data.role in ['student', 'teacher', 'admin'])) &&
             data.updatedAt is timestamp;
    }

    function isValidGameScore(data) {
      return data.keys().hasAll(['userId', 'playerName', 'gameType', 'score', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'playerName', 'gameType', 'score', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 64 &&
             data.gameType is string && data.gameType.size() > 0 && data.gameType.size() <= 32 &&
             data.score is number && data.score >= 0 &&
             data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar', 'role', 'updatedAt']);
      allow delete: if false;
    }

    match /gameScores/{scoreId} {
      allow get: if isValidId(scoreId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(scoreId) && isSignedIn() && isValidGameScore(incoming());
      allow update, delete: if false;
    }
  }
}
